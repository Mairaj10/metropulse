[Unit]
Description=MetroPulse Dagster Webserver
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/metropulse
EnvironmentFile=/home/ubuntu/metropulse/.env
Environment="DAGSTER_HOME=/home/ubuntu/.dagster_home"
Environment="PATH=/home/ubuntu/metropulse/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/metropulse/.venv/bin/dagster-webserver -w /home/ubuntu/metropulse/workspace.yaml -h 127.0.0.1 -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target